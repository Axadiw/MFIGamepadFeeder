<Window x:Class="MFIGamepadFeeder.App.MappingEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MFIGamepadFeeder.App"
        Title="Mapping Editor"
        Width="960"
        Height="640"
        MinWidth="780"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FA"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <local:NullableIntConverter x:Key="NullableIntConverter" />
        <local:NullableByteConverter x:Key="NullableByteConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="New" Click="NewButton_Click" Margin="0,0,6,0" />
                <Button Content="Open..." Click="OpenButton_Click" Margin="0,0,6,0" />
                <Button Content="Save" Click="SaveDirectButton_Click" Margin="0,0,6,0" Background="#1F883D" Foreground="White" FontWeight="SemiBold" />
                <Button Content="Save As..." Click="SaveAsButton_Click" />
            </StackPanel>
            <TextBlock x:Name="FilePathText" Text="Unsaved mapping" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#57606A" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Live HID Byte Preview -->
        <GroupBox Grid.Row="1" Header="Live Raw HID Byte Inspector (Select Device to Watch Byte Indices)">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Preview Device:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="PreviewDeviceComboBox" SelectionChanged="PreviewDeviceComboBox_SelectionChanged" />
                </DockPanel>
                <TextBlock x:Name="LiveBytesText" Text="Waiting for HID input..." FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <!-- Optional Config Metadata -->
        <GroupBox Grid.Row="2" Header="Optional Config Defaults (Leave Blank to Use App Defaults)">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Report ID (0-255):" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="ReportIdTextBox" Width="55" Margin="0,0,16,0" VerticalContentAlignment="Center" ToolTip="Optional expected byte[0] Report ID; leave blank to accept any Report ID." />

                <TextBlock Text="Default Deadzone (%):" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="DeadzonePctTextBox" Width="55" Margin="0,0,16,0" VerticalContentAlignment="Center" ToolTip="Optional default stick deadzone percentage (0..50)." />

                <TextBlock Text="Default Button Threshold (1-255):" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="ButtonThresholdTextBox" Width="55" VerticalContentAlignment="Center" ToolTip="Optional default minimum pressure value (1..255) for analog MFi buttons." />
            </StackPanel>
        </GroupBox>

        <!-- Mapping Tabs -->
        <TabControl x:Name="EditorTabs" Grid.Row="3" Margin="0,0,0,8">
            <TabItem Header="Buttons &amp; Axes Mapping">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="ItemsDataGrid"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="True"
                              SelectionMode="Single"
                              Background="White"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Row" Binding="{Binding RowIndex}" IsReadOnly="True" Width="45" />
                            <DataGridComboBoxColumn x:Name="TypeColumn" Header="Type" SelectedItemBinding="{Binding Type, UpdateSourceTrigger=PropertyChanged}" Width="85" />
                            <DataGridComboBoxColumn x:Name="ButtonColumn" Header="Button / DPad" SelectedItemBinding="{Binding ButtonType, UpdateSourceTrigger=PropertyChanged}" Width="115" />
                            <DataGridComboBoxColumn x:Name="AxisColumn" Header="Axis" SelectedItemBinding="{Binding AxisType, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridCheckBoxColumn Header="Signed Stick" Binding="{Binding ConvertAxis, UpdateSourceTrigger=PropertyChanged}" Width="82" />
                            <DataGridCheckBoxColumn Header="Unsigned 128" Binding="{Binding UnsignedCentered, UpdateSourceTrigger=PropertyChanged}" Width="88" />
                            <DataGridCheckBoxColumn Header="Invert" Binding="{Binding InvertAxis, UpdateSourceTrigger=PropertyChanged}" Width="52" />
                            <DataGridTextColumn Header="CustomIndex" Binding="{Binding CustomIndex, Converter={StaticResource NullableIntConverter}}" Width="85" />
                            <DataGridTextColumn Header="CustomMask" Binding="{Binding CustomValue, Converter={StaticResource NullableIntConverter}}" Width="85" />
                            <DataGridTextColumn Header="Threshold" Binding="{Binding Threshold, Converter={StaticResource NullableByteConverter}}" Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="+ Add Mapping Row" Click="AddRowButton_Click" Margin="0,0,6,0" />
                        <Button Content="- Remove Selected Row" Click="RemoveRowButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Virtual Keys (Button Combos)">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Map multi-button combinations (e.g., LBumper + RBumper + Start -&gt; Back) to Xbox 360 buttons missing on MFi controllers. Longer combos automatically take precedence."
                               Foreground="#57606A"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <DataGrid x:Name="VirtualKeysDataGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="True"
                              SelectionMode="Single"
                              Background="White"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn x:Name="VkSource1Column" Header="Source Key 1" SelectedItemBinding="{Binding SourceKey1, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                            <DataGridComboBoxColumn x:Name="VkSource2Column" Header="Source Key 2" SelectedItemBinding="{Binding SourceKey2, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                            <DataGridComboBoxColumn x:Name="VkSource3Column" Header="Source Key 3" SelectedItemBinding="{Binding SourceKey3, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                            <DataGridComboBoxColumn x:Name="VkSource4Column" Header="Source Key 4" SelectedItemBinding="{Binding SourceKey4, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                            <DataGridComboBoxColumn x:Name="VkDestinationColumn" Header="Output Button" SelectedItemBinding="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="+ Add Virtual Key Combo" Click="AddVirtualKeyButton_Click" Margin="0,0,6,0" />
                        <Button Content="- Remove Selected Combo" Click="RemoveVirtualKeyButton_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="4">
            <TextBlock Text="Tip: CustomIndex &amp; CustomMask support bit-packed controllers like SteelSeries Nimbus+." Foreground="#57606A" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Close" Click="CloseButton_Click" />
        </DockPanel>
    </Grid>
</Window>
