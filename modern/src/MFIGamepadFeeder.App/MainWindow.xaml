<Window x:Class="MFIGamepadFeeder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MFI Gamepad Feeder (Modern x64)"
        Width="860"
        Height="660"
        MinWidth="740"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F6F8FA"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Driver / Bus Status Banner -->
        <Border x:Name="DriverBanner" Grid.Row="0" CornerRadius="6" Padding="12,8" Margin="0,0,0,10" Background="#FFF8C5" BorderBrush="#D4A72C" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Button x:Name="RefreshDriversButton" DockPanel.Dock="Right" Content="Re-check Driver" Click="RefreshDriversButton_Click" Margin="10,0,0,0" />
                <TextBlock x:Name="DriverStatusText" Text="Checking virtual Xbox 360 bus driver..." TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1F2328" />
            </DockPanel>
        </Border>

        <!-- Controller Setup -->
        <GroupBox Grid.Row="1" Header="Controller &amp; Mapping Setup">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="MFi HID Device:" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox x:Name="DeviceComboBox" Grid.Row="0" Grid.Column="1" Margin="6,4" SelectionChanged="DeviceComboBox_SelectionChanged" />
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ShowAllHidCheckBox" Content="Show all HID" VerticalAlignment="Center" Margin="6,0" Checked="ShowAllHidCheckBox_Changed" Unchecked="ShowAllHidCheckBox_Changed" />
                    <Button x:Name="RefreshDevicesButton" Content="Refresh" Click="RefreshDevicesButton_Click" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mapping File:" VerticalAlignment="Center" Margin="0,4" />
                <ComboBox x:Name="MappingComboBox" Grid.Row="1" Grid.Column="1" Margin="6,4" SelectionChanged="MappingComboBox_SelectionChanged" />
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BrowseMappingButton" Content="Browse..." Click="BrowseMappingButton_Click" Margin="6,0,4,0" />
                    <Button x:Name="OpenEditorButton" Content="Mapping Editor" Click="OpenEditorButton_Click" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Virtual Slot / Bus:" VerticalAlignment="Center" Margin="0,6,0,0" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="6,6,0,0" VerticalAlignment="Center">
                    <ComboBox x:Name="SlotComboBox" Width="70" Margin="0,0,12,0" />
                    <TextBlock Text="Driver Backend:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="BackendComboBox" Width="170" />
                </StackPanel>
                <Button x:Name="StartStopButton" Grid.Row="2" Grid.Column="2" Content="Start Feeding" MinWidth="135" Margin="6,6,0,0" FontWeight="Bold" Background="#1F883D" Foreground="White" Click="StartStopButton_Click" />
            </Grid>
        </GroupBox>

        <!-- Live Input Tuning -->
        <GroupBox Grid.Row="2" Header="Live Input Tuning (Applies Immediately)">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <DockPanel>
                        <TextBlock Text="Stick Deadzone:" />
                        <TextBlock x:Name="DeadzoneValueText" DockPanel.Dock="Right" Text="6%" FontWeight="SemiBold" />
                    </DockPanel>
                    <Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="25" Value="6" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="TuningControl_Changed" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <DockPanel>
                        <TextBlock Text="Button Pressure Threshold:" />
                        <TextBlock x:Name="ThresholdValueText" DockPanel.Dock="Right" Text="1" FontWeight="SemiBold" />
                    </DockPanel>
                    <Slider x:Name="ThresholdSlider" Minimum="1" Maximum="128" Value="1" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="TuningControl_Changed" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <CheckBox x:Name="InvertLeftYCheckBox" Content="Invert Left Stick Y" Margin="0,2" Checked="TuningControl_Changed" Unchecked="TuningControl_Changed" />
                    <CheckBox x:Name="InvertRightYCheckBox" Content="Invert Right Stick Y" Margin="0,2" Checked="TuningControl_Changed" Unchecked="TuningControl_Changed" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Live Telemetry Monitor -->
        <GroupBox Grid.Row="3" Header="Live Xbox 360 Output &amp; Raw HID Monitor">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock x:Name="SessionStatusText" Text="Status: Stopped" FontWeight="Bold" />
                    <TextBlock x:Name="StatsText" DockPanel.Dock="Right" Text="0 Hz | Submitted: 0 | Skipped: 0 | Reconnects: 0" Foreground="#57606A" />
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Left Stick (LX, LY)" FontSize="11" Foreground="#57606A" />
                        <TextBlock x:Name="LeftStickText" Text="0, 0" FontFamily="Consolas" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Right Stick (RX, RY)" FontSize="11" Foreground="#57606A" />
                        <TextBlock x:Name="RightStickText" Text="0, 0" FontFamily="Consolas" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock x:Name="LeftTriggerLabel" Text="Left Trigger: 0" FontSize="11" Foreground="#57606A" />
                        <ProgressBar x:Name="LeftTriggerBar" Minimum="0" Maximum="255" Height="12" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock x:Name="RightTriggerLabel" Text="Right Trigger: 0" FontSize="11" Foreground="#57606A" />
                        <ProgressBar x:Name="RightTriggerBar" Minimum="0" Maximum="255" Height="12" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2" x:Name="ButtonsText" Text="Active Buttons: None" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock Grid.Row="3" x:Name="RawBytesText" Text="Raw HID Bytes: (waiting for controller input)" FontFamily="Consolas" FontSize="11" Foreground="#57606A" TextWrapping="Wrap" />
            </Grid>
        </GroupBox>

        <!-- Diagnostic Log -->
        <GroupBox Grid.Row="4" Header="Log (Nimbus Virtual Keys: LB+RB+Menu=Back | LB+Menu=L3 | RB+Menu=R3)">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="Clear Log" Click="ClearLogButton_Click" />
                </StackPanel>
                <TextBox x:Name="LogTextBox"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Background="White" />
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>
